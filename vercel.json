{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/desenho", "destination": "/desenho/index.html" },
    { "source": "/desenho/(.*)", "destination": "/desenho/$1" },
    { "source": "/desenho-v2", "destination": "/desenho-v2/index.html" },
    { "source": "/desenho-v2/(.*)", "destination": "/desenho-v2/$1" }
  ]
}
